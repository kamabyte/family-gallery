<?xml version="1.0" encoding="utf-8"?>
<!--
  The catalog and image cache hold private metadata (dates, GPS places, filenames, camera
  info). None of it should leave the device via cloud backup or device-to-device transfer;
  it is always re-syncable from the NAS. Exclude everything from both flows.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
