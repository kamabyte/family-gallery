<?xml version="1.0" encoding="utf-8"?>
<!--
  Pre-Compose cold-start window background: the app logo centered on the dark splash background,
  so the very first frame already shows the brand and hands off seamlessly to the Compose splash
  (GalleryStartupSplash), which pins its logo at the same size/position and adds the loading bar.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0A0C11" />
        </shape>
    </item>

    <item
        android:drawable="@drawable/ic_launcher"
        android:gravity="center"
        android:width="132dp"
        android:height="132dp" />
</layer-list>
