<!--
  The `android:roundIcon` variant (API 26+). Same layers as ic_launcher: the background is already
  a circle, so the two are identical by construction — but launchers that look for a round icon
  specifically (MIUI does) need the resource to exist under this name or they fall back to the
  legacy square one.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
